# Backend database connection (used by backend/app/core/config.py, scripts/seed_database.py)
DATABASE_URL=postgresql+psycopg://recoverai:recoverai_pw@localhost:5432/recoverai

# Razorpay (Phase 5). RAZORPAY_MODE=mock (default, and what runs if the
# keys below are blank) uses MockPaymentProvider -- no network calls, no
# account needed. Set RAZORPAY_MODE=test with real *test-mode* credentials
# from your Razorpay Dashboard (Settings > API Keys; free, no business
# verification needed) to exercise RazorpayPaymentProvider for real against
# https://api.razorpay.com. Never set this to a live-mode key pair --
# live execution is out of scope for this project.
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks when you add a webhook pointing at
# POST /api/webhooks/razorpay (subscribe to the payment_link.paid event).
RAZORPAY_WEBHOOK_SECRET=

# LLM agent (Phase 3+). Google Gemini -- get a free-tier key at aistudio.google.com.
# If unset, the investigation agent falls back to a deterministic mock narrative
# generator (no LLM calls, no crash) -- see backend/app/agents/llm_client.py.
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Frontend (used by frontend/src/lib/api.ts)
# API_URL is used for server-side fetches inside the frontend container/process.
# NEXT_PUBLIC_API_URL is used for any client-side fetches and is baked into the browser bundle.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
